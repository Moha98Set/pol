# Installed to /etc/polly/polly.env  (chmod 640, root:polly)
#
# systemd parses this itself: no `export`, no shell expansion, no $VAR
# references. Quote any value containing spaces.
#
# Every name below is read by config.py. `python config.py` prints the
# resolved value of each one and labels where it came from, which is the
# fastest way to confirm this file is actually being applied.

# --- What to run -------------------------------------------------------
# default | conservative | research | smoke
PROFILE=default

# --- Storage -----------------------------------------------------------
# Must be under the unit's ReadWritePaths, or SQLite gets EROFS.
DB_PATH=/var/lib/polly/arb_monitor.db

# --- Scan pacing -------------------------------------------------------
# Roughly 2100 events are fetchable; the pre-filter keeps about a quarter,
# and each survivor costs a few seconds of order-book round trips. Left
# uncapped a full scan runs ~30 minutes, i.e. longer than SCAN_INTERVAL,
# so scans would simply run back to back forever.
#
# Capping is not sampling: events arrive ordered by 24h volume, so the cap
# keeps the most liquid slice — exactly the part worth looking at.
# Raise it toward 0 (uncapped) once you know how long a scan really takes
# on this host. See DEPLOY.md for how to measure that.
SCAN_INTERVAL=900
MAX_EVENTS_SCAN=800

# --- Logging -----------------------------------------------------------
# text goes to journald and stays readable under `journalctl -u`.
# Set LOG_FORMAT=json only if you are shipping the journal somewhere that
# parses it; LOG_FILE is redundant under systemd and is left unset so the
# journal is the single source.
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Thresholds (optional) ---------------------------------------------
# Uncomment to override the profile. These are the knobs worth touching
# first; config.py lists the rest.
# MIN_NET_EDGE=0.003
# MIN_VOLUME_24H=1000
# NEAR_MISSES_PER_SCAN=20

# --- Live engine (optional) --------------------------------------------
# How many events the WebSocket streams. Only these can produce a window,
# so this is the coverage limit and currently the tightest one: ~670 events
# pass the pre-filters and 40 are watched. Raising it costs memory and
# socket budget (see MAX_TOKENS_PER_SOCKET, ~2.5 tokens per event).
# LIVE_TOP_N=40
# LIVE_MIN_EDGE=0.003

# --- Verdict retention -------------------------------------------------
# The dashboard's "markets" and "rejected" tabs read one row per event per
# scan. Uncapped that is ~200k rows a day, so it is pruned to the most
# recent N scans. 96 is a day at a 15-minute interval. 0 disables pruning.
VERDICT_RETENTION_SCANS=96

# --- Dashboard ---------------------------------------------------------
# 0.0.0.0 publishes on every interface. Set 127.0.0.1 instead to make the
# dashboard reachable only through an SSH tunnel:
#     ssh -L 8971:127.0.0.1:8971 root@<server>
POLLY_DASH_HOST=0.0.0.0
POLLY_DASH_PORT=8971

# Each analyst gets an account, created with the CLI:
#     sudo -u polly /opt/polly/venv/bin/python /opt/polly/dashboard.py --add-user sara
#     ... --list-users        who exists, and when they last logged in
#     ... --logins 50         the last 50 login attempts
#
# Accounts live in /var/lib/polly/dashboard.db, not here. The two keys
# below are the older single login; they are still read, and on first
# start are imported as the first account so an existing deployment is
# not locked out by the upgrade. New accounts do not need them.
POLLY_DASH_USER=analyst
POLLY_DASH_PASSWORD_HASH=

# Signs the session cookie. Changing it logs everyone out.
POLLY_DASH_SECRET_KEY=

# --- Edge recording ----------------------------------------------------
# The live engine evaluates the edge on every book update. Recording keeps
# the episodes that never reached the execute threshold — a market that
# dips for ten minutes and recovers is invisible to a 15-minute scan.
LIVE_RECORD=1
LIVE_RECORD_MIN_EDGE=-0.02
LIVE_TICK_MIN_INTERVAL_MS=1000
TICK_RETENTION_DAYS=7

# --- Alerts (optional) -------------------------------------------------
# Unset, notify.py is a no-op. Set both to get a Telegram message when an
# opportunity is stored or a live window crosses the execute threshold.
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_MIN_EDGE=0.005
# ALERT_COOLDOWN_SEC=900

# --- Trading -----------------------------------------------------------
# Deliberately absent. This host observes only. Adding
# POLYMARKET_PRIVATE_KEY / POLYMARKET_FUNDER_ADDRESS / POLYMARKET_ALLOW_LIVE
# here is the entire difference between a monitor and a machine that
# spends money, so it should be a considered change, not a default.
